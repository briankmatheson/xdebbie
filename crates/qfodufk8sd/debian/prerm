#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        echo "Stopping qfodufk8sd service..."
        systemctl stop qfodufk8sd.service || true
        ;;
        
    failed-upgrade)
        ;;
        
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
