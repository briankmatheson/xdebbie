#!/bin/sh
set -e

case "$1" in
    purge)
        echo "Purging qfodufk8sd configuration and state..."
        
        # Remove configuration
        rm -rf /etc/qfodufk8s
        
        # Remove state
        rm -rf /var/lib/qfodufk8s
        
        # Reload systemd
        systemctl daemon-reload || true
        
        echo "qfodufk8sd completely removed."
        ;;
        
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Reload systemd
        systemctl daemon-reload || true
        ;;
        
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
