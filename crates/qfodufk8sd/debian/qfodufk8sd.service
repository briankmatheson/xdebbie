[Unit]
Description=qfodufk8s VM Orchestrator
Documentation=https://github.com/yourusername/qfodufk8s
After=network-online.target libvirtd.service local-fs.target
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
ExecStartPre=/usr/bin/qfodufk8sd bootstrap
ExecStart=/usr/bin/qfodufk8sd serve
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qfodufk8sd

# Run as root to access libvirt
User=root
Group=root

# Working directory
WorkingDirectory=/var/lib/qfodufk8s

# Security hardening (relaxed for libvirt access)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/qfodufk8s /var/lib/qfodufk8s /var/lib/libvirt /run/libvirt

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
