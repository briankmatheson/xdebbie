#!/bin/sh
set -e

case "$1" in
    configure)
        # Create directories
        mkdir -p /etc/xdebbie
        mkdir -p /var/lib/xdebbie
        
        # Set permissions (root owned for libvirt access)
        chmod 755 /etc/xdebbie
        chmod 755 /var/lib/xdebbie
        # Files holding the API token are root:root 0400 (older releases
        # left xdebbie_env world-readable).
        for f in /etc/xdebbie/token /etc/xdebbie/token.previous /etc/xdebbie/xdebbie_env; do
            [ -e "$f" ] && chown root:root "$f" && chmod 0400 "$f" || true
        done
        
        # Geneve kernel module for the optional overlay mesh (also listed in
        # /etc/modules-load.d/xdebbie-mesh.conf for boot). Harmless if unused.
        modprobe geneve 2>/dev/null || true
        modprobe wireguard 2>/dev/null || true

        # Reload systemd
        systemctl daemon-reload || true
        
        # Enable service (will start on boot)
        systemctl enable xdebbied.service || true
        
        # Configure AppArmor for libvirt backing images
        if command -v apparmor_parser >/dev/null 2>&1; then
            echo "Configuring AppArmor for libvirt..."
            mkdir -p /etc/apparmor.d/local
            if [ ! -f /etc/apparmor.d/local/usr.lib.libvirt.virt-aa-helper ]; then
                touch /etc/apparmor.d/local/usr.lib.libvirt.virt-aa-helper
            fi
            # Add rule if not already present
            if ! grep -q "Allow xdebbie backing images" /etc/apparmor.d/local/usr.lib.libvirt.virt-aa-helper 2>/dev/null; then
                cat >> /etc/apparmor.d/local/usr.lib.libvirt.virt-aa-helper << 'EOF'
# Allow xdebbie backing images
/var/lib/libvirt/images/*.qcow2 r,
EOF
                apparmor_parser -r /etc/apparmor.d/usr.lib.libvirt.virt-aa-helper 2>/dev/null || true
            fi
            # wireguard-tools ships a profile for /usr/bin/wg that only allows
            # keys under /etc/wireguard; our local/wg override (shipped as a
            # conffile) also allows /var/lib/xdebbie/wg.key. Reload it.
            if [ -f /etc/apparmor.d/wg ]; then
                apparmor_parser -r /etc/apparmor.d/wg 2>/dev/null || true
            fi
        fi
        
        # Run bootstrap on first install
        if [ ! -f /etc/xdebbie/xdebbied.toml ]; then
            echo "Running initial bootstrap..."
            /usr/bin/xdebbied bootstrap || true
        fi
        
        # Start service
        echo "Starting xdebbied service..."
        systemctl start xdebbied.service || true
        
        echo ""
        echo "xdebbied installed successfully!"
        echo ""
        echo "Check status:"
        echo "  systemctl status xdebbied"
        echo ""
        echo "View logs:"
        echo "  journalctl -u xdebbied -f"
        echo ""
        echo "Configure client (run as your user):"
        echo "  export XDEBBIE_URL=http://127.0.0.1:7443"
        echo "  export XDEBBIE_TOKEN=\$(sudo cat /etc/xdebbie/token)"
        echo "  xdctl host ls"
        echo ""
        echo "Or, from a root shell (the file is root:root 0400):"
        echo "  source /etc/xdebbie/xdebbie_env"
        echo ""
        ;;
        
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
        
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
