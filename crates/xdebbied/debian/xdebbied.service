[Unit]
Description=xdebbie VM Orchestrator
Documentation=https://github.com/yourusername/xdebbie
After=network-online.target local-fs.target lvm2-monitor.service
After=libvirtd.service virtqemud.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/xdebbied bootstrap
ExecStart=/usr/bin/xdebbied serve
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xdebbied

# Run as root to access libvirt
User=root
Group=root

# Working directory
WorkingDirectory=/var/lib/xdebbie

# Security hardening. ProtectSystem=full keeps /usr, /boot and /etc
# read-only; the paths below are what bootstrap and serve write:
#   /etc/xdebbie              config, token, env file
#   /etc/lvm                  lvm archive/backup on lvcreate
#   /etc/ufw /etc/default/ufw bootstrap's firewall rules and `ufw enable`
#   /dev                      device-mapper nodes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/xdebbie /etc/lvm /etc/ufw /etc/default/ufw /var/lib/xdebbie /var/lib/libvirt /run/libvirt /dev

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
