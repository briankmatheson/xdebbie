[Unit]
Description=Flock VM orchestrator
Documentation=https://github.com/bmatheson/flock
After=network-online.target
Wants=network-online.target

[Service]
User=flock
Group=flock
ExecStart=/usr/local/bin/flockd --config /etc/flock/flockd.toml serve
Restart=always
RestartSec=2
StateDirectory=flock
ConfigurationDirectory=flock
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/flock

[Install]
WantedBy=multi-user.target
