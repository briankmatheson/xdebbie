# wg-quick config for the mesh client: docs/network/clients.md,
# "How it works". No Endpoint for the hub: the hub dials this server.
[Interface]
PrivateKey = ${private_key}
Address = ${address}/16
ListenPort = ${listen_port}
MTU = 1420

[Peer]
PublicKey = ${hub_pubkey}
# the hub itself, and the overlay behind it (VMs, services)
AllowedIPs = 10.22.0.1/32, 10.23.0.0/16
PersistentKeepalive = 25
